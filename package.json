{
  "name": "facewise",
  "version": "0.1.0",
  "description": "Faces in pictures and video, in the browser, behind one interface: detect, landmark and (soon) track, with backends loaded only when used.",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "schema": "vite-node scripts/export-json-schema.ts",
    "test:e2e": "playwright test",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "face-detection",
    "face-landmarks",
    "face-anonymization",
    "de-identification",
    "mediapipe",
    "browser",
    "privacy"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reeleehq/facewise.git"
  },
  "homepage": "https://github.com/reeleehq/facewise#readme",
  "bugs": "https://github.com/reeleehq/facewise/issues",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mediapipe": {
      "types": "./dist/mediapipe/index.d.ts",
      "import": "./dist/mediapipe/index.js"
    },
    "./schemas/faces-1.schema.json": "./schemas/faces-1.schema.json"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "bin": {
    "facewise-assets": "./bin/facewise-assets.mjs"
  },
  "files": [
    "dist",
    "schemas",
    "bin",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@mediapipe/tasks-vision": "^1.2.3"
  },
  "wads": {
    "ci": {
      "packageManager": "npm",
      "nodeVersions": [
        "22",
        "24"
      ],
      "publishNode": "24",
      "lintCommand": "npm run typecheck",
      "testCommand": "npm test",
      "buildCommand": "npm run build",
      "publish": {
        "enabled": true,
        "marker": "[publish-npm]",
        "registry": "https://registry.npmjs.org",
        "provenance": true,
        "trustedPublishing": true,
        "access": "public"
      }
    }
  }
}
